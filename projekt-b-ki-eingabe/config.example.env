# Kopiere diese Datei nach ".env" und trage deine echten Werte ein.
# Die ".env" wird NICHT in git eingecheckt (siehe .gitignore).

# Adresse der KI auf dem anderen Rechner im Netzwerk.
#
# Beispiel Ollama (auf Mac Studio oder Windows-PC, Standardport 11434),
# OpenAI-kompatibler Endpunkt:
#   REMOTE_AI_URL=http://mac-studio.local:11434/v1/chat/completions
#   REMOTE_AI_STYLE=openai
#
# Beispiel Ollama, natives Protokoll:
#   REMOTE_AI_URL=http://mac-studio.local:11434/api/chat
#   REMOTE_AI_STYLE=ollama
#
# Beispiel LM Studio (Windows-PC, Standardport 1234):
#   REMOTE_AI_URL=http://windows-pc.local:1234/v1/chat/completions
#   REMOTE_AI_STYLE=openai
REMOTE_AI_URL=
REMOTE_AI_STYLE=openai

# Name des Modells, wie es auf dem entfernten Server geladen ist
# (z.B. "llama3.1", "qwen2.5", je nachdem was dort installiert ist).
REMOTE_AI_MODEL=

# Nur noetig, falls der entfernte Server einen API-Key verlangt.
# Bei Ollama/LM Studio im lokalen Netz meist leer lassen.
REMOTE_AI_API_KEY=

# Whisper-Modellgroesse: tiny, base, small, medium, large-v3
WHISPER_MODEL_SIZE=small

# Optional: Index des Mikrofons, siehe:
#   python3 voice_input.py --list-devices
MIC_DEVICE_INDEX=
