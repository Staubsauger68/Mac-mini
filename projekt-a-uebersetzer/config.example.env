# Kopiere diese Datei nach ".env" und trage deine echten Werte ein.
# Die ".env" wird NICHT in git eingecheckt (siehe .gitignore).

# DeepL API-Key (kein Benutzername/Passwort!). Zu finden im DeepL-Account
# unter "Konto" -> "API-Keys". Falls du nur einen kostenlosen Account
# hast, endet der Key auf ":fx".
DEEPL_API_KEY=

# Whisper-Modellgroesse: tiny, base, small, medium, large-v3
# "small" ist ein guter Kompromiss aus Geschwindigkeit und Genauigkeit
# auf einem Mac mini. Fuer mehr Genauigkeit "medium" probieren.
WHISPER_MODEL_SIZE=small

# Optional: Index des Mikrofons, falls nicht das Standardgeraet
# verwendet werden soll. Herausfinden mit:
#   python3 translator.py --list-devices
MIC_DEVICE_INDEX=
